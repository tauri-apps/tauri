{
  "productName": "tauri-ffi-api-deno",
  "version": "1.0.0",
  "identifier": "com.tauri.ffi.api.deno",
  "build": {
    "runner": { "cmd": "deno", "args": ["run", "-A", "main.ts"] },
    "beforeDevCommand": { "script": "node ../../bindings/scripts/stage-dev.mjs --lang deno --runtime wry && pnpm dev", "cwd": "../../../../examples/api" },
    "beforeBuildCommand": { "script": "node ../../bindings/scripts/stage-dev.mjs --lang deno --runtime wry && pnpm build", "cwd": "../../../../examples/api" },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../../../examples/api/dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "../../../../examples/.icons/32x32.png",
      "../../../../examples/.icons/128x128.png",
      "../../../../examples/.icons/128x128@2x.png",
      "../../../../examples/.icons/icon.icns",
      "../../../../examples/.icons/icon.ico"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tauri API — Deno",
        "url": "index.html",
        "width": 1000,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400
      }
    ]
  }
}
