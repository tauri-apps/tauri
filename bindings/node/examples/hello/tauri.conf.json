{
  "productName": "tauri-ffi-hello",
  "version": "0.1.0",
  "identifier": "com.tauri.ffi.hello",
  "build": {
    "runner": { "cmd": "node", "args": ["main.js"] },
    "frontendDist": "./assets"
  },
  "bundle": {
    "active": true,
    "icon": [
      "../../../../examples/.icons/32x32.png",
      "../../../../examples/.icons/128x128.png",
      "../../../../examples/.icons/128x128@2x.png",
      "../../../../examples/.icons/icon.icns",
      "../../../../examples/.icons/icon.ico"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tauri FFI — Node.js",
        "url": "index.html",
        "width": 600,
        "height": 440
      }
    ]
  }
}
