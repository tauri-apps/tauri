{
  "name": "@tauri-apps/node",
  "version": "0.1.0",
  "description": "Experimental Node.js bindings to Tauri over the tauri-ffi C ABI (no native glue code)",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./worker": "./src/worker.js",
    "./plugin": "./src/plugin.js",
    "./ffi": "./src/ffi.js",
    "./api": {
      "types": "./src/api/index.d.ts",
      "default": "./src/api/index.js"
    },
    "./api/*": {
      "types": "./src/api/*.d.ts",
      "default": "./src/api/*.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@tauri-apps/api": "../../packages/api/dist",
    "esbuild": "^0.25.0",
    "koffi": "^3.0.0",
    "postject": "^1.0.0-alpha.6"
  },
  "devDependencies": {
    "node-api-headers": "^1.9.0"
  }
}
