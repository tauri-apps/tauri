{
  "productName": "tauri-ffi-api-py",
  "version": "1.0.0",
  "identifier": "com.tauri.ffi.api.python",
  "build": {
    "runner": { "cmd": "python3", "args": ["main.py"] },
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../../../../examples/api"
    },
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../../../../examples/api"
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../../../examples/api/dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "../../../../examples/.icons/32x32.png",
      "../../../../examples/.icons/128x128.png",
      "../../../../examples/.icons/128x128@2x.png",
      "../../../../examples/.icons/icon.icns",
      "../../../../examples/.icons/icon.ico"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tauri API — Python",
        "url": "index.html",
        "width": 1000,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400
      }
    ]
  }
}
