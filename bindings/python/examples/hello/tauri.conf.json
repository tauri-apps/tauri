{
  "productName": "tauri-ffi-hello-py",
  "version": "0.1.0",
  "identifier": "com.tauri.ffi.hello.python",
  "build": {
    "runner": { "cmd": "python3", "args": ["main.py"] },
    "beforeDevCommand": { "script": "node ../../../scripts/stage-dev.mjs --lang python --runtime wry", "cwd": ".", "wait": true },
    "beforeBuildCommand": { "script": "node ../../../scripts/stage-dev.mjs --lang python --runtime wry", "cwd": "." },
    "frontendDist": "./assets"
  },
  "bundle": {
    "active": true,
    "icon": [
      "../../../../examples/.icons/32x32.png",
      "../../../../examples/.icons/128x128.png",
      "../../../../examples/.icons/128x128@2x.png",
      "../../../../examples/.icons/icon.icns",
      "../../../../examples/.icons/icon.ico"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tauri FFI — Python",
        "url": "index.html",
        "width": 600,
        "height": 440
      }
    ]
  }
}
