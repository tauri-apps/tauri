{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{ app_name }}",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "{{ window_title }}",
        "url": "{{#if dev_url}}{{ dev_url }}{{else}}https://tauri.app{{/if}}",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
