{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    // Playwright transpiles the specs itself (babel); bundler-style resolution
    // is what matches that at type-check time.
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["playwright.config.ts", "e2e/**/*.ts"]
}
