{
  "identifier": "browser-ui",
  "description": "The browser's own pages (title bar, qtbrowser:// pages): every browser command, window controls and the plugin APIs the About page uses.",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "os:default",
    "process:allow-restart",
    "allow-browser-state",
    "allow-new-tab",
    "allow-close-tab",
    "allow-activate-tab",
    "allow-move-tab",
    "allow-navigate",
    "allow-go-back",
    "allow-go-forward",
    "allow-reload",
    "allow-stop",
    "allow-zoom",
    "allow-new-window",
    "allow-reopen-closed-tab",
    "allow-focus-content",
    "allow-shortcut",
    "allow-open-menu",
    "allow-page-context-menu",
    "allow-site-info-menu",
    "allow-page-html",
    "allow-get-settings",
    "allow-save-settings",
    "allow-clear-browsing-data",
    "allow-pick-download-dir",
    "allow-set-autostart",
    "allow-about-info",
    "allow-watch-downloads",
    "allow-download-action"
  ]
}
