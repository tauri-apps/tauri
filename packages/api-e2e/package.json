{
  "name": "@tauri-apps/api-e2e",
  "private": true,
  "version": "0.0.0",
  "description": "End-to-end test suite for @tauri-apps/api, driven against the examples/api app via WebdriverIO.",
  "license": "Apache-2.0 OR MIT",
  "type": "module",
  "scripts": {
    "e2e": "wdio run ./wdio.conf.ts",
    "e2e:skip-build": "cross-env E2E_SKIP_BUILD=true wdio run ./wdio.conf.ts",
    "e2e:cef": "cross-env E2E_RUNTIME=cef wdio run ./wdio.conf.ts",
    "e2e:cef:skip-build": "cross-env E2E_RUNTIME=cef E2E_SKIP_BUILD=true wdio run ./wdio.conf.ts",
    "ts:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@crabnebula/tauri-driver": "^2.0.9",
    "@crabnebula/test-runner-backend": "^0.2.9",
    "@tauri-apps/api": "../api/dist",
    "@types/node": "^22.10.0",
    "@wdio/cli": "^9.31.9",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.9",
    "@wdio/mocha-framework": "^9.31.9",
    "@wdio/spec-reporter": "^9.31.2",
    "cross-env": "^10.1.0",
    "typescript": "^6.0.3",
    "webdriverio": "^9.31.9"
  }
}
